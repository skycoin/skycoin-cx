package main

// Ackermann(3, 5) 350 times, 42,438 calls each.

func fnv(h ui64, v ui64) (out ui64) {
	out = (h ^ v) * 1099511628211UL
}

func ackermann(m i32, n i32) (out i32) {
	if m == 0 {
		out = n + 1
	} else {
		if n == 0 {
			out = ackermann(m-1, 1)
		} else {
			out = ackermann(m-1, ackermann(m, n-1))
		}
	}
}

func main() {
	var h ui64
	h = 14695981039346656037UL
	var ok bool
	ok = true
	var r i32
	var round i32
	for round = 0; round < 350; round++ {
		r = ackermann(3, 5)
		h = fnv(h, i32.ui64(r))
		ok = ok && r == 253
	}
	ui64.print(h)
	if ok {
		printf("ackermann pass\n")
	} else {
		printf("ackermann FAIL\n")
	}
}

// https://github.com/skycoin/cx/issues/540b

package main

import "sys/string"

func main() {
	for h := 0; h < 3; h++ {
		for i := 0; i < 3; i++ {
			for j := 0; j < 3; j++ {
				printf("j: %d \n", j)
                break
			}
			string.PrintLine("out of j loop")
		}
		string.PrintLine("out of i loop")
	}
	string.PrintLine("out of h loop")
}
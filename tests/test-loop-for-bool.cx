package main

func main() {
	var b bool = true
	var n i32
	for b {
		n = n + 1
		if n > 2 {
			b = false
		}
	}
	i32.print(n)

	b = true
	n = 0
	for i := 0; b; i++ {
		n = n + 10
		if i == 1 {
			b = false
		}
	}
	i32.print(n)

	n = 0
	for n < 5 && b == false {
		n = n + 2
	}
	i32.print(n)

	n = 0
	for i := 0; ; i++ {
		if i > 6 {
			break
		}
		n = i
	}
	i32.print(n)

	j := 0
	n = 0
	for i := 0; i < 4; i = j {
		j = i + 1
		n = n + i
	}
	i32.print(n)
}

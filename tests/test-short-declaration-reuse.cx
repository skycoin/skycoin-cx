package main

func two() (i32, i32) {
	return 3, 4
}

func main() {
	a, b := 1, 2
	a, c := 5, 6
	printf("%d %d %d\n", a, b, c)
	if true {
		a, d := 7, 8
		printf("%d %d\n", a, d)
	}
	printf("%d\n", a)
	b, e := two()
	printf("%d %d\n", b, e)
	var s str = "x"
	s, n := "y", 1
	printf("%s %d\n", s, n)
}

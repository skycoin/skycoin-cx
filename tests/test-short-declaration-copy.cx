package main

type Point struct {
	x i32
	y i64
}

func main() {
	var big i64 = 5000000000L
	x := big
	y := 7
	i64.print(x)
	i32.print(y)
	var d f64 = 0.125D
	e := d
	z := 8
	f64.print(e)
	i32.print(z)
	var p Point
	p.x = 3
	p.y = 6000000000L
	v := p.y
	w := 9
	i64.print(v)
	i32.print(w)
	t := Point{x: 1, y: 2L}
	g := t
	h := 10
	i32.print(g.x)
	i64.print(g.y)
	i32.print(h)
	q := p
	i64.print(q.y)
}

package main

type P struct {
	x i32
}

func pair() (arr [2]i32) {
	arr[0] = 3
	arr[1] = 4
}

func triple(x i32) (arr [3]i32) {
	var t [3]i32
	t[0] = x
	t[1] = x + 1
	t[2] = x + 2
	return t
}

func product(a [2]i32) (r i32) {
	r = a[0] * a[1]
}

func points() (arr [2]P) {
	arr[0].x = 7
	arr[1].x = 8
}

func halves() (arr [2]f64) {
	arr[0] = 1.5D
	arr[1] = 2.25D
}

func main() {
	var a [2]i32
	a = pair()
	test(a[0]+a[1], 7, "assign")

	b := pair()
	test(b[1], 4, "short declaration")

	var c [2]i32 = pair()
	test(c[0], 3, "declaration")

	var d [3]i32
	d = triple(5)
	test(d[0]+d[1]+d[2], 18, "return statement")

	test(product(pair()), 12, "nested call")
	test(pair()[1], 4, "index the call")

	var p [2]P
	p = points()
	test(p[0].x+p[1].x, 15, "struct elements")

	var h [2]f64
	h = halves()
	test(h[0]+h[1], 3.75D, "f64 elements")
}

// Language revision 1, https://github.com/skycoin/skycoin-cx/issues/183

package main

import "sys/string"

func main() {
	var x str
	var y str
	var z str
	x = "apple"
	y = x
	z = string.Concatenation("app", "le")

	test(string.EqualityByByteValue(x, z), true, "equal_by_value same bytes")
	test(string.EqualityByByteValue(x, "banana"), false, "equal_by_value different bytes")
	test(string.EqualityByByteValue("", ""), true, "equal_by_value empty")

	test(string.EqualityByHeapPointer(x, y), true, "equal_by_pointer after assignment")
	test(string.EqualityByHeapPointer(x, z), false, "equal_by_pointer distinct objects")

	test(string.OrderingByByteValue("a", "b"), -1, "compare_by_value a b")
	test(string.OrderingByByteValue("b", "a"), 1, "compare_by_value b a")
	test(string.OrderingByByteValue(x, z), 0, "compare_by_value equal")
	test(string.OrderingByByteValue("ab", "a"), 1, "compare_by_value prefix")
	test(string.OrderingByByteValue("", "a"), -1, "compare_by_value empty")
}

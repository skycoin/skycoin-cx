package main

func main() {
	for i := 0; i < 6; i++ {
		if i % 2 == 0 {
			continue
		} else {
			if i == 5 {
				break
			}
		}
		printf("odd %d\n", i)
	}
	n := 0
	for i := 0; i < 10; i++ {
		for j := 0; j < 10; j++ {
			if j < i {
				continue
			} else {
				break
			}
		}
		if i == 3 {
			break
		} else {
			n = n + i
		}
	}
	i32.print(n)
}

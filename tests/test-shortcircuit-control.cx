package main

var calls i32

func T(i i32) (out bool) {
	printf("T%d ", i)
	calls = calls + 1
	out = true
}

func F(i i32) (out bool) {
	printf("F%d ", i)
	calls = calls + 1
	out = false
}

func main() {
	if T(1) || T(2) {
		printf("then\n")
	}
	if F(3) && T(4) {
		printf("bad\n")
	} else {
		printf("else\n")
	}
	if F(5) || (T(6) && bool.not(F(7))) {
		printf("then\n")
	}

	n := 0
	for i := 0; i < 3 && T(i); i++ {
		n = n + 1
	}
	printf("n %d\n", n)
	for j := 0; j >= 2 || T(10 + j); j++ {
		if j == 3 {
			break
		}
	}
	printf("\n")

	x := 0
	if x != 0 && 10 / x > 1 {
		printf("bad\n")
	}
	if x == 0 || 10 / x > 1 {
		printf("no divide\n")
	}

	var a [2]i32
	a[0] = 5
	for k := 0; k < 2 && a[k] > 0; k++ {
		printf("a[%d] %d\n", k, a[k])
	}
	k := 2
	if k < 2 && a[k] == 0 {
		printf("bad\n")
	}
	i32.print(calls)
}

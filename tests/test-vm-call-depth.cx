// Recursion with small frames reaches the call depth limit before the stack
// is full. vm stops with a stack overflow error. The old loop crashes with
// an index out of range in RuntimeError (skycoin-cx#408).
package main

func recur(n i32) {
	recur(n + 1)
}

func main() {
	i32.print(1)
	recur(1)
}

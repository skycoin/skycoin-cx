package main
import "sys/cx"
import "sys/os"

func main () {
	var x i32 = 1
	if false {
		var xThen i32
		if true {
			var xThenNested i32 = 3
			test(xThenNested, 3, "")
		}
		test(xThen, 0, "")
	} else {
		var xElse i32 = 5
		if true {
			var xElseNested i32 = 3
		}
	}
	test(x, 1, "")

	if x == 1 {
		test(x, 1, "")
		var xBody i32 = 5
		test(xBody, 5, "")
		if true {
			var xBodyNested i32 = 3
			test(xBodyNested, 3, "")
		}
		test(xBody, 5, "")
	} else {
		printf("scopes are not working properly for if statements")
		os.Exit(cx.PANIC)
	}

	var y i32 = 3131
	
	for yOuter := 0; yOuter < 10; yOuter++ {
		for yInner := 10; yInner < 20; yInner++ {
			test(yInner >= 10, true, "")
		}
		test(yOuter < 10, true, "")
	}

	test(y, 3131, "")
}

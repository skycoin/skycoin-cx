package geometry

type Point struct {
	X i32
	Y i32
}

var Count i32 = 7

func Distance(a Point, b Point) i32 {
	return b.X - a.X + b.Y - a.Y
}

func (p Point) Sum() i32 {
	return p.X + p.Y
}

package main

import . "geometry"

type Segment struct {
	From Point
	To   Point
}

var Start Point = Point{X: 1, Y: 1}
var Length = Distance(Point{X: 0, Y: 0}, Point{X: 3, Y: 4})

func length(s Segment) i32 {
	return Distance(s.From, s.To)
}

func main() {
	global Start, Length, Count
	segment := Segment{From: Start, To: Point{X: 4, Y: 5}}
	points := []Point{{X: 1, Y: 2}, Point{X: 3, Y: 4}}
	pointer := &Point{X: 2, Y: 3}
	Count = Count + 1
	printf("%d %d %d %d %d %d\n", length(segment), Length, points[1].Sum(), pointer.Sum(), Count, geometry.Distance(Start, Start))
}

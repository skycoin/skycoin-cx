// https://github.com/skycoin/cx/issues/266

package main

import "sys/string"

func main () {
	var cmd str
beginning:
	cmd = "P"

	if string.EqualityByByteValue(cmd, "C") {
		goto cat
	}

	if string.EqualityByByteValue(cmd, "D") {
		goto dog
	}

	if string.EqualityByByteValue(cmd, "P") {
		goto pigeon
	}

cat:
	test(cmd, "C", "")
	cmd = "E"
	goto end
dog:
	test(cmd, "D", "")
	cmd = "C"
	goto cat
pigeon:
	test(cmd, "P", "")
	cmd = "D"
	goto dog

end:
	test(cmd, "E", "")
}

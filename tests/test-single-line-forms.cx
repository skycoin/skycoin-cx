package main

type Empty struct{}
type One struct { a i32 }
type Two struct { a i32; b i32 }
type Three struct { a i32; b i32; c i32; }

func (o One) get() i32 { return o.a }
func (o *One) add(n i32) i32 { o.a = o.a + n; return o.a }
func double(n i32) i32 { return n * 2 }
func ptr(n i32) *One { return &One{a: n} }
func list() []i32 { return []i32{4, 5} }
func name() bool { return true }
func pair() (a i32, b i32) { a = 1; b = 2; return }
func nothing() {}
func sign(n i32) i32 { if n < 0 { return -1 } else if n == 0 { return 0 } else { return 1 } }
func sum(n i32) i32 { var s i32; for i := 0; i < n; i++ { s = s + i }; return s }

func main() {
	var t Two
	t.a = 2; t.b = 3
	i32.print(t.a + t.b)
	var h Three = Three{a: 1, b: 2, c: 3}
	i32.print(h.a + h.b + h.c)
	var o One = One{a: 7}
	i32.print(o.get())
	i32.print(o.add(3))
	i32.print(double(21))
	i32.print(ptr(9).a)
	i32.print(list()[1])
	bool.print(name())
	var a i32
	var b i32
	a, b = pair()
	i32.print(a + b)
	nothing()
	i32.print(sign(-5) + sign(0) + sign(8))
	i32.print(sum(4))
	var c i32 = 1 /* a comment
	that holds a newline ends the statement */ i32.print(c)
	var e Empty
	e = Empty{}
}

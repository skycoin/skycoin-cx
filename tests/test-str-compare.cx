// Language revision 1 replaced the str ordering operators with
// string.OrderingByByteValue. https://github.com/skycoin/skycoin-cx/issues/183

package main

import "sys/string"

func main() {
	test(string.OrderingByByteValue("b", "a") > 0, true, "b > a")
	test(string.OrderingByByteValue("a", "b") > 0, false, "a > b")
	test(string.OrderingByByteValue("a", "a") > 0, false, "a > a")
	test(string.OrderingByByteValue("a", "a") >= 0, true, "a >= a")
	test(string.OrderingByByteValue("a", "b") >= 0, false, "a >= b")
	test(string.OrderingByByteValue("a", "b") < 0, true, "a < b")
	test(string.OrderingByByteValue("b", "a") < 0, false, "b < a")
	test(string.OrderingByByteValue("a", "a") < 0, false, "a < a")
	test(string.OrderingByByteValue("a", "a") <= 0, true, "a <= a")
	test(string.OrderingByByteValue("b", "a") <= 0, false, "b <= a")

	var x str
	var y str
	x = "apple"
	y = "banana"
	test(string.OrderingByByteValue(x, y), -1, "apple before banana")
	test(string.OrderingByByteValue(y, x), 1, "banana after apple")
	test(string.OrderingByByteValue(x, x), 0, "apple equals apple")
}

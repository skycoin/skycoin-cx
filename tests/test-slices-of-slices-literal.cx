package main

func main() {
	var m [][]i32
	m = [][]i32{[]i32{0, 1}, []i32{2, 3}}
	test(len(m), 2, "")
	test(len(m[0]), 2, "")
	test(len(m[1]), 2, "")
	test(m[1][0], 2, "")
	test(m[1][1], 3, "")

	m = [][]i32{[]i32{0, 1}, []i32{2, 3}, []i32{4, 5}}
	test(len(m[1]), 2, "")
	test(len(m[2]), 2, "")
	test(m[2][1], 5, "")
}

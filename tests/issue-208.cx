package main
import "sys/glfw"
import "sys/gl"
func main() {
	glfw.Init()
	glfw.WindowHint(glfw.Resizable, glfw.False)
	glfw.CreateWindow("test_15", 800, 600, "test_15")
	glfw.MakeContextCurrent("test_15")

	gl.Init()

	var vbo i32
	gl.GenBuffers(1, vbo)
}

// https://github.com/skycoin/cx/issues/208

package main
import "sys/glfw"
import "sys/gl"
func main() {
	glfw.Init()
	glfw.WindowHint(glfw.Resizable, glfw.False)
	var window i32
	window = glfw.CreateWindow(800, 600, "test_15")
	glfw.MakeContextCurrent(window)

	gl.Init()

	var vbo i32
	gl.GenBuffers(1, vbo)
}

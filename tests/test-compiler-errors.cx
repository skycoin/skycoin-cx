package main

import "sys/compiler"
import "sys/cxir"
import "sys/os"

// Parses the program on standard input, which has type errors, and a
// program with a syntax error, and reads the errors sys/compiler keeps: their
// count, lines and messages (D152).

func sourceRead() (source [4096]ui8, size i32) {
	var line [256]ui8
	var i i32
	var length i32 = os.InputLineRead(line)
	for length >= 0 {
		for i = 0; i < length; i++ {
			source[size] = line[i]
			size++
		}
		source[size] = 10UB
		size++
		length = os.InputLineRead(line)
	}
}

func errorsPrint() {
	var message [256]ui8
	var count i32 = compiler.CxCompilerErrorCountGet()
	var i i32
	var length i32
	for i = 0; i < count; i++ {
		length = compiler.CxCompilerErrorMessageRead(i, message)
		printf("error %d at line %d, %d bytes, starts with %d %d %d %d %d\n", i, compiler.CxCompilerErrorSourceLineGet(i), length, message[0], message[1], message[2], message[3], message[4])
	}
	printf("past the last error: line %d, read %d\n", compiler.CxCompilerErrorSourceLineGet(count), compiler.CxCompilerErrorMessageRead(count, message))
}

func main() {
	var source [4096]ui8
	var size i32
	source, size = sourceRead()
	var name i64 = cxir.CxStringPoolTextAppend([9]ui8{101UB, 114UB, 114UB, 111UB, 114UB, 115UB, 46UB, 99UB, 120UB}, 9)
	var file i32 = compiler.CxCompilerSourceFileAppend(name, source, size)
	var ast i64 = compiler.CxCompilerSourceParse()
	printf("file %d, parsed %v, type check %d, errors kept %d\n", file, ast > 0L, compiler.CxCompilerProgramTypeCheck(ast), compiler.CxCompilerErrorCountGet())
	errorsPrint()
	printf("lower a program with errors %d\n", compiler.CxCompilerProgramLower(ast))

	file = compiler.CxCompilerSourceFileAppend(name, source, size)
	printf("compile it %d, errors %d\n", compiler.CxCompilerProgramCompile(), compiler.CxCompilerErrorCountGet())

	var broken [24]ui8 = [24]ui8{112UB, 97UB, 99UB, 107UB, 97UB, 103UB, 101UB, 32UB, 109UB, 97UB, 105UB, 110UB, 10UB, 102UB, 117UB, 110UB, 99UB, 32UB, 109UB, 97UB, 105UB, 110UB, 40UB, 123UB}
	file = compiler.CxCompilerSourceFileAppend(name, broken, 24)
	printf("parse a syntax error %d\n", compiler.CxCompilerSourceParse())
	errorsPrint()
	printf("parse with no source %d, errors %d\n", compiler.CxCompilerSourceParse(), compiler.CxCompilerErrorCountGet())
	printf("append with no name %d, past the buffer %d\n", compiler.CxCompilerSourceFileAppend(0L, broken, 1), compiler.CxCompilerSourceFileAppend(name, broken, 25))
	printf("release %d, again %d, type check after %d\n", compiler.CxCompilerAstRelease(ast), compiler.CxCompilerAstRelease(ast), compiler.CxCompilerProgramTypeCheck(ast))
}

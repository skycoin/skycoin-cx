package main

import "sys/string"

func main () (out i32) {
	for true {
		string.PrintLine("Enter a number greater than 0: ")
		var value str
		value = read()

		if i32.gt(string.ParseDecimalI32(value), 0) {
			string.PrintLine("Good, good.")
		} else {
			halt("The number was not greater than 0.")
		}
	}
}

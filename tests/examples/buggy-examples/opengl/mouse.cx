package main

import "sys/gl"
import "sys/glfw"
import "sys/string"

var gameWindow i32

var width i32 = 400
var height i32 = 300

func mouseButton (window i32, key i32, action i32, mods i32) () {
	x, y := glfw.GetCursorPos(gameWindow)
	if key == glfw.MouseButtonLeft {
		if action == glfw.Press {
			string.PrintLine("mouse button left pressed at:")
			string.PrintLine(string.Concatenation("x: ", f64.str(x)))
			string.PrintLine(string.Concatenation("y: ", f64.str(y)))
		}
		if action == glfw.Release {
			string.PrintLine("mouse button left released at:")
			string.PrintLine(string.Concatenation("x: ", f64.str(x)))
			string.PrintLine(string.Concatenation("y: ", f64.str(y)))
		}
	}

	if key == glfw.MouseButtonRight {
		if action == glfw.Press {
			string.PrintLine("mouse button right pressed at:")
			string.PrintLine(string.Concatenation("x: ", f64.str(x)))
			string.PrintLine(string.Concatenation("y: ", f64.str(y)))
		}
		if action == glfw.Release {
			string.PrintLine("mouse button right released at:")
			string.PrintLine(string.Concatenation("x: ", f64.str(x)))
			string.PrintLine(string.Concatenation("y: ", f64.str(y)))
		}
	}

	if key == glfw.MouseButtonMiddle {
		if action == glfw.Press {
			string.PrintLine("mouse button middle pressed at:")
			string.PrintLine(string.Concatenation("x: ", f64.str(x)))
			string.PrintLine(string.Concatenation("y: ", f64.str(y)))
		}
		if action == glfw.Release {
			string.PrintLine("mouse button middle released at:")
			string.PrintLine(string.Concatenation("x: ", f64.str(x)))
			string.PrintLine(string.Concatenation("y: ", f64.str(y)))
		}
	}
}

func mouseCursor (window i32, xpos f64, ypos f64) () {
	x, y := glfw.GetCursorPos(gameWindow)
	string.PrintLine("mouse cursor at:")
	string.PrintLine(string.Concatenation("x: ", f64.str(x)))
	string.PrintLine(string.Concatenation("y: ", f64.str(y)))
}

func main () () { global width, height
	glfw.Init()

	gameWindow = glfw.CreateWindow(width, height, "Mouse Interaction")
	glfw.MakeContextCurrent(gameWindow)
	
	gl.Init()
	program := gl.CreateProgram()
	gl.LinkProgram(program)

	glfw.SetMouseButtonCallback(gameWindow, mouseButton)
	
	// Uncomment this like to print where is the cursor at any moment
	//glfw.SetCursorPosCallback(gameWindow, mouseCursor)

	
	//glfw.SetInputMode(gameWindow, glfw.Cursor, glfw.CursorDisabled)
	//glfw.SetInputMode(gameWindow, glfw.Cursor, glfw.CursorHidden)
	//glfw.SetInputMode(gameWindow, glfw.Cursor, glfw.CursorNormal)

	for not(glfw.ShouldClose(gameWindow)) {
		bufferWidth, bufferHeight := glfw.GetFramebufferSize(gameWindow)
		ratio = f32.div(i32.f32(bufferWidth), i32.f32(bufferHeight))

		gl.Clear(gl.COLOR_BUFFER_BIT)

		gl.UseProgram(program)
		
		glfw.PollEvents()
		glfw.SwapBuffers(gameWindow)
	}
}

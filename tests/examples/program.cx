// Main package 
// It is important to write it to run the main function
//In CX programing we can create many pakages and also utilize existing packages 
// 
package main

import "http"
import "sys/string"
var i i32


type Point struct {
	x i32
	y i32
}

// This main function will print a string in the terminal
// string.PrintLine("") prints the string 
func main () {

    var	loco i32

	string.PrintLine("print string")

 	string.PrintLine("Hello World!")

	string.PrintLine("print 2+3*3")

	i32.print(2+3*3) 

	string.PrintLine("call function sayhi()")

	sayHi()

	
	var p Point

	p.x = 100
	p.y = 200

	string.PrintLine("print  struct point")


	i32.print(p.x)
	i32.print(p.y)


	i = 20

	string.PrintLine("print  global varialble")

	i32.print(i)


    loco = 20
    
    string.PrintLine("print  local varialble")
    i32.print(loco)
}

func sayHi () () {
	string.PrintLine("Hi")
}


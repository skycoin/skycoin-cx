package main

import "sys/string"

func main () {
	var out i32
	
     	if false {
		var error i32
		error = i32.div(50, 0)
		string.PrintLine("This will never be printed")
	}

	if true {
		string.PrintLine("This will always print")
	}

	if i32.gt(5, 3) {
		string.PrintLine("5 is greater than 3")
	}

	if i32.lteq(50, 5) {
		out = 100
	} else {
		out = 200
	}

	i32.print(out)
}

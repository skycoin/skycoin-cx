package main

import "sys/string"

var foo i32

func bar () {
    string.PrintLine("Hi.")
}

type foobar struct {
    foo i32
}

func main () {
    var target aff
    var result []ui8

    target = #{
        pkg(main)
        var(foo)
    }
    result = serialize(target)
    
    target = #{
        pkg(main)
        fn(bar)
    }
    result = serialize(target)
    
    target = #{pkg(main) strct(foobar)}
    result = serialize(target)
}

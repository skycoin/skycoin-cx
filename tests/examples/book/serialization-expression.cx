package main

type Point struct {
    x i32
    y i32
}

func main () {
    var target aff
    var result []ui8
    
    var foo i32
    var bar Point
    
    i32.print(foo)

    target = #{
        pkg(main)
        fn(main)
        var(foo)
    }
    result = serialize(target)
    
    target = #{
        pkg(main)
        fn(main)
        var(bar)
    }
    result = serialize(target)
}

package main

var globalValue i32

func foo () { global globalValue
    i32.print(globalValue)
    // i32.print(local) // this will raise an error if uncommented
}

func main () { global globalValue
    var local i32
    
    local = 10
    globalValue = 15
    
    i32.print(globalValue)
    i32.print(local)
}

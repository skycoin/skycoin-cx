package main

import "sys/string"

type Player struct {
    name str
}

type Referee struct {
    name str
}

func (p *Player) printName () {
    string.PrintLine("Player information")
    string.PrintLine((*p).name)
}

func (r *Referee) printName () {
    string.PrintLine("Referee information")
    string.PrintLine((*r).name)
}

func main () {
    var p Player
    p.name = "Michael"
    
    var r Referee
    r.name = "Edward"

    p.printName()
    r.printName()
}

// An echo server on port 9000. Run with cx --enable=net, see
// docs/Networking.md.
package main

import "sys/net"

var buffer [1024]ui8

func main() { global buffer
	var listener i32 = net.TCPListen("127.0.0.1", 9000)
	var count i32
	var handle i32
	var trigger i32
	var message i32
	var detail i32
	var length i32
	var queued i32
	var closed bool
	var i i32
	for true {
		count = net.Update(1000)
		for i = 0; i < count; i++ {
			handle, trigger, message, detail = net.ReadyNext()
			if trigger == net.TriggerListening {
				printf("listening on port %d\n", detail)
			}
			if trigger == net.TriggerError {
				printf("error %d on socket %d\n", detail, handle)
				return
			}
			if trigger == net.TriggerData {
				length = net.Read(handle, message, buffer, 0)
				queued = net.Write(handle, buffer, length)
			}
			if trigger == net.TriggerClosed {
				closed = net.Close(handle)
			}
		}
	}
}

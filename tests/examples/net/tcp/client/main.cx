// Sends hello to the echo server on port 9000 and prints the answer. Run
// with cx --enable=net, see docs/Networking.md.
package main

import "sys/net"

var buffer [1024]ui8

func main() { global buffer
	var connection i32 = net.TCPDial("127.0.0.1", 9000)
	var count i32
	var handle i32
	var trigger i32
	var message i32
	var detail i32
	var length i32
	var queued i32
	var i i32
	for true {
		count = net.Update(1000)
		for i = 0; i < count; i++ {
			handle, trigger, message, detail = net.ReadyNext()
			if trigger == net.TriggerConnected {
				buffer[0] = 104UB
				buffer[1] = 105UB
				queued = net.Write(connection, buffer, 2)
			}
			if trigger == net.TriggerError {
				printf("error %d\n", detail)
				return
			}
			if trigger == net.TriggerData {
				length = net.Read(handle, message, buffer, 0)
				printf("the server answered %d bytes\n", length)
				return
			}
		}
	}
}

# The check scripts compare these files line by line, so keep LF on Windows too.
*.sh text eol=lf
*.txt text eol=lf
*.cx text eol=lf
*.go text eol=lf

# Recorded stdout is compared byte for byte, see docs/ExecutionRecords.md.
tests/execution-records/*.out -text

# A replay record is part of the input hash of a record, see docs/Networking.md.
*.netreplay -text
